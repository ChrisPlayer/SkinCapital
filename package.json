{
  "name": "cs2-inventory-tracker",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "CS2 inventory tracker with Storage Units support and price monitoring",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"wait-on tcp:3000 && vite\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "tsx src/server/index.ts",
    "start:dist": "node dist/server/server.cjs",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:win": "powershell -ExecutionPolicy Bypass -File scripts/package-win.ps1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@tanstack/react-query": "^5.62.8",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "globaloffensive": "^3.0.0",
    "helmet": "^8.0.0",
    "https-proxy-agent": "^9.0.0",
    "lucide-react": "^0.468.0",
    "node-cron": "^3.0.3",
    "p-queue": "^6.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "steam-session": "^1.9.4",
    "steam-user": "^5.0.9",
    "steamcommunity": "^3.47.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.49",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.6",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.4"
  }
}
