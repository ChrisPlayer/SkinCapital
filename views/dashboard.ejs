<!DOCTYPE html>
<html lang="fr" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CS2 Inventory Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cs: { orange: '#DE9B35', purple: '#8847FF', pink: '#D32CE6', red: '#EB4B4B', blue: '#5E98D9', gray: '#1B2838', dark: '#0E1419', surface: '#16202D' }
                    }
                }
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0f1218;
            color: #e5e7eb;
            min-height: 100vh;
            /* Mesh gradient background */
            background-image:
                radial-gradient(at 0% 0%, rgba(136, 71, 255, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(222, 155, 53, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(211, 44, 230, 0.1) 0px, transparent 50%);
            background-attachment: fixed;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .glass {
            background: rgba(22, 32, 45, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .glass-hover:hover {
            border-color: rgba(222, 155, 53, 0.3);
            box-shadow: 0 0 30px rgba(222, 155, 53, 0.05);
        }

        .gradient-text {
            background: linear-gradient(135deg, #DE9B35, #D32CE6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .item-card {
            transition: all 0.2s ease;
        }

        .item-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        }

        .float-bar {
            height: 4px;
            border-radius: 2px;
            background: linear-gradient(90deg, #4CAF50 0%, #8BC34A 15%, #FFC107 38%, #FF9800 45%, #F44336 100%);
            position: relative;
        }

        .float-marker {
            position: absolute;
            top: -3px;
            width: 3px;
            height: 10px;
            background: white;
            border-radius: 1px;
            transform: translateX(-50%);
            box-shadow: 0 0 6px rgba(255, 255, 255, 0.5);
        }

        .tab-active {
            border-color: #DE9B35;
            color: #DE9B35;
            background: rgba(222, 155, 53, 0.1);
        }

        .tab-inactive {
            border-color: transparent;
            color: #6b7280;
        }

        .tab-inactive:hover {
            color: #9ca3af;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .folder-card {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .folder-card:hover {
            border-color: rgba(136, 71, 255, 0.4);
            box-shadow: 0 4px 20px rgba(136, 71, 255, 0.1);
        }

        .folder-card.open {
            border-color: rgba(136, 71, 255, 0.5);
        }

        .folder-contents {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease;
        }

        .folder-contents.open {
            max-height: 2000px;
            overflow-y: auto;
        }

        .fade-in {
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .item-img {
            width: 72px;
            height: 54px;
            object-fit: contain;
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
        }

        .badge {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }
    </style>
</head>

<body class="text-gray-100">
    <!-- Header -->
    <header class="sticky top-0 z-50 glass border-b border-white/5 shadow-2xl shadow-cs-purple/10">
        <div class="max-w-[1600px] mx-auto px-6 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div
                        class="w-10 h-10 bg-gradient-to-br from-cs-orange to-cs-purple rounded-xl flex items-center justify-center shadow-lg shadow-cs-orange/20 relative group overflow-hidden">
                        <div
                            class="absolute inset-0 bg-white/20 blur-sm group-hover:opacity-100 opacity-0 transition-opacity">
                        </div>
                        <span
                            class="text-2xl transform group-hover:scale-110 transition-transform cursor-default">🐱</span>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold gradient-text tracking-tight">CS2 Inventory Tracker</h1>
                        <p class="text-[11px] text-gray-500 flex items-center gap-2">
                            <% if (status.isConnectedToGC) { %>
                                <span class="flex items-center gap-1"><span
                                        class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span> GC
                                    Online</span>
                                <% } else { %>
                                    <span class="flex items-center gap-1 text-yellow-400"><span
                                            class="w-1.5 h-1.5 bg-yellow-400 rounded-full"></span> GC Offline</span>
                                    <% } %>
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right hidden sm:block">
                        <p class="text-[10px] text-gray-500 uppercase tracking-widest font-semibold">Valeur Totale</p>
                        <p class="text-xl font-black text-white tracking-tight">€<%= totalValue.toFixed(2) %>
                        </p>
                    </div>
                    <% if (isRefreshing) { %>
                        <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center animate-spin">
                            <svg class="w-5 h-5 text-cs-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                        </div>
                        <% } else { %>
                            <form action="/refresh" method="POST" class="inline">
                                <button type="submit"
                                    class="w-10 h-10 rounded-xl bg-white/5 hover:bg-white/10 flex items-center justify-center transition-all hover:scale-105 active:scale-95 group relative"
                                    title="Rafraîchir">
                                    <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors"
                                        fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                    </svg>
                                    <span
                                        class="absolute -bottom-1 -right-1 w-2.5 h-2.5 bg-green-500 rounded-full border-2 border-[#16202D]"></span>
                                </button>
                            </form>
                            <% } %>
                                <a href="/logout"
                                    class="w-10 h-10 rounded-xl bg-red-500/10 hover:bg-red-500/20 flex items-center justify-center transition-all hover:scale-105 text-red-500"
                                    title="Déconnexion">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                </a>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-[1600px] mx-auto px-6 py-6">
        <% if (typeof error !=='undefined' && error) { %>
            <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-300 text-sm">
                <strong>Erreur:</strong>
                <%= error %>
            </div>
            <% } %>

                <!-- KPI Cards -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6 fade-in">
                    <div class="glass rounded-2xl p-5 glass-hover">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Items Total</p>
                        <p class="text-3xl font-extrabold text-white">
                            <%= totalItems %>
                        </p>
                        <p class="text-xs text-gray-500 mt-1">
                            <%= uniqueItems %> uniques
                        </p>
                    </div>
                    <div class="glass rounded-2xl p-5 glass-hover">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Storage Units</p>
                        <p class="text-3xl font-extrabold text-cs-purple">
                            <%= storageUnits.length %>
                        </p>
                        <p class="text-xs text-gray-500 mt-1">
                            <%= totalItems - mainInventory.count %> items stockés
                        </p>
                    </div>
                    <div class="glass rounded-2xl p-5 glass-hover">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Valeur Totale</p>
                        <p class="text-3xl font-extrabold text-cs-orange">€<%= totalValue.toFixed(2) %>
                        </p>
                        <p class="text-xs text-gray-500 mt-1">Steam Market</p>
                    </div>
                    <div class="glass rounded-2xl p-5 glass-hover">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Évolution 24h</p>
                        <% if (change24h.hasData) { %>
                            <p
                                class="text-3xl font-extrabold <%= change24h.percentage >= 0 ? 'text-green-400' : 'text-red-400' %>">
                                <%= change24h.percentage>= 0 ? '+' : '' %><%= change24h.percentage.toFixed(1) %>%
                            </p>
                            <p class="text-xs text-gray-500 mt-1">
                                <%= change24h.change>= 0 ? '+' : '' %>€<%= change24h.change.toFixed(2) %>
                            </p>
                            <% } else { %>
                                <p class="text-3xl font-extrabold text-gray-600">—</p>
                                <p class="text-xs text-gray-600 mt-1">Pas de données</p>
                                <% } %>
                    </div>
                </div>

                <!-- Chart -->
                <div class="glass rounded-2xl p-6 mb-6 fade-in">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wider">Historique de valeur
                        </h2>
                        <div class="flex gap-1">
                            <a href="?days=7&tab=<%= tab %>"
                                class="px-3 py-1 text-xs rounded-lg transition-all <%= days === 7 ? 'bg-cs-orange/20 text-cs-orange' : 'text-gray-500 hover:text-gray-300' %>">7J</a>
                            <a href="?days=30&tab=<%= tab %>"
                                class="px-3 py-1 text-xs rounded-lg transition-all <%= days === 30 ? 'bg-cs-orange/20 text-cs-orange' : 'text-gray-500 hover:text-gray-300' %>">30J</a>
                            <a href="?days=90&tab=<%= tab %>"
                                class="px-3 py-1 text-xs rounded-lg transition-all <%= days === 90 ? 'bg-cs-orange/20 text-cs-orange' : 'text-gray-500 hover:text-gray-300' %>">90J</a>
                        </div>
                    </div>
                    <div class="h-52"><canvas id="historyChart"></canvas></div>
                </div>

                <!-- Daily History Table -->
                <div class="glass rounded-2xl p-6 mb-6 fade-in overflow-hidden">
                    <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wider mb-4">Historique Journalier
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="text-xs text-gray-500 border-b border-white/5">
                                    <th class="py-3 font-medium uppercase tracking-wider">Date</th>
                                    <th class="py-3 font-medium uppercase tracking-wider text-right">Valeur Totale</th>
                                    <th class="py-3 font-medium uppercase tracking-wider text-right">Variation (€)</th>
                                    <th class="py-3 font-medium uppercase tracking-wider text-right">Variation (%)</th>
                                </tr>
                            </thead>
                            <tbody class="text-sm">
                                <% if (typeof dailyHistory !=='undefined' && dailyHistory && dailyHistory.length> 0) {
                                    %>
                                    <% dailyHistory.forEach(function(day) { %>
                                        <tr
                                            class="border-b border-white/5 last:border-0 hover:bg-white/5 transition-colors">
                                            <td class="py-3 font-mono text-gray-300">
                                                <%= new Date(day.date).toLocaleDateString('fr-FR') %>
                                            </td>
                                            <td class="py-3 font-mono text-right font-bold text-gray-200">€<%=
                                                    day.value.toFixed(2) %>
                                            </td>
                                            <td
                                                class="py-3 font-mono text-right font-bold <%= day.change >= 0 ? 'text-green-400' : 'text-red-400' %>">
                                                <%= day.change>= 0 ? '+' : '' %>€<%= day.change.toFixed(2) %>
                                            </td>
                                            <td
                                                class="py-3 font-mono text-right font-bold <%= day.changePercent >= 0 ? 'text-green-400' : 'text-red-400' %>">
                                                <%= day.changePercent>= 0 ? '+' : '' %><%= day.changePercent.toFixed(2)
                                                        %>%
                                            </td>
                                        </tr>
                                        <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="4" class="py-4 text-center text-gray-500 text-xs">
                                                        Aucune donnée historique disponible</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tabs -->
                <div class="flex gap-1 mb-6 border-b border-white/5 fade-in">
                    <a href="?tab=main&days=<%= days %>"
                        class="px-5 py-3 text-sm font-medium border-b-2 transition-all rounded-t-lg <%= tab === 'main' ? 'tab-active' : 'tab-inactive' %>">
                        🎒 Inventaire (<%= mainInventory.count %>)
                    </a>
                    <a href="?tab=caskets&days=<%= days %>"
                        class="px-5 py-3 text-sm font-medium border-b-2 transition-all rounded-t-lg <%= tab === 'caskets' ? 'tab-active' : 'tab-inactive' %>">
                        🗄️ Storage Units (<%= storageUnits.length %>)
                    </a>
                    <button onclick="collapseAll()"
                        class="px-3 py-1.5 text-xs font-medium text-gray-400 bg-white/5 hover:bg-white/10 rounded-lg transition-colors">
                        Tout fermer
                    </button>
                </div>

                <% if (tab==='caskets' ) { %>
                    <% if (storageUnits.length===0) { %>
                        <div class="glass rounded-2xl p-8 text-center text-gray-500">Aucune Storage Unit avec des items
                        </div>
                        <% } %>
                            <% storageUnits.forEach(function(su, idx) { %>
                                <div class="glass rounded-2xl folder-card border border-white/5 hover:border-cs-purple/50 transition-all duration-300 hover:shadow-[0_0_30px_rgba(136,71,255,0.15)] group relative overflow-hidden"
                                    id="folder-<%= idx %>">

                                    <!-- Folder Header (clickable) -->
                                    <div class="p-5 flex items-center justify-between cursor-pointer relative z-50 hover:bg-white/5 transition-colors rounded-t-2xl folder-header-toggle"
                                        onclick="toggleFolder('<%= idx %>')" data-idx="<%= idx %>">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-12 h-12 rounded-xl bg-gradient-to-br from-cs-purple/30 to-cs-pink/20 flex items-center justify-center text-xl border border-cs-purple/20">
                                                <span id="folder-icon-<%= idx %>">📂</span>
                                            </div>
                                            <div>
                                                <p class="text-base font-bold text-white">
                                                    <%= su.name %>
                                                </p>
                                                <p class="text-xs text-gray-500 mt-0.5">
                                                    <span class="font-mono text-gray-600">...<%= su.short_id %></span>
                                                    <span class="mx-2 text-gray-700">•</span>
                                                    <span>
                                                        <%= su.item_count %> items
                                                    </span>
                                                    <span class="mx-2 text-gray-700">•</span>
                                                    <span>
                                                        <%= su.unique_items %> uniques
                                                    </span>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-4">
                                            <div class="text-right">
                                                <p class="text-xl font-extrabold text-cs-orange">€<%=
                                                        su.total_value.toFixed(2) %>
                                                </p>
                                            </div>
                                            <svg id="chevron-<%= idx %>"
                                                class="w-5 h-5 text-gray-500 transition-transform duration-300 -rotate-90"
                                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M19 9l-7 7-7-7" />
                                            </svg>
                                        </div>
                                    </div>

                                    <!-- Folder Contents -->
                                    <div class="folder-contents hidden" id="contents-<%= idx %>">
                                        <div class="border-t border-white/5 px-5 pb-5">
                                            <% if (su.items.length===0) { %>
                                                <div class="text-center p-4 text-gray-500 bg-white/5 rounded-xl">
                                                    <p>Aucun item trouvé</p>
                                                    <p class="text-xs mt-1">Item count reported: <%= su.item_count %>
                                                    </p>
                                                </div>
                                                <% } else { %>
                                                    <div
                                                        class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2 pt-4">
                                                        <% su.items.forEach(function(ci) { %>
                                                            <!-- Item Card -->
                                                            <div class="flex items-center gap-3 p-3 rounded-xl bg-black/20 hover:bg-black/40 transition-colors item-card group border border-transparent hover:border-white/10 relative overflow-hidden cursor-pointer item-click-target"
                                                                data-name="<%= ci.market_hash_name %>"
                                                                data-image="<%= ci.imageUrl %>"
                                                                data-rarity-color="<%= ci.rarity ? ci.rarity.color : '#ccc' %>"
                                                                data-rarity-name="<%= ci.rarity ? ci.rarity.name : 'Common' %>">
                                                                <!-- Rarity highlight -->
                                                                <div class="absolute left-0 top-0 bottom-0 w-1"
                                                                    style="background: <%= ci.rarity ? ci.rarity.color : '#666' %>; opacity: 0.5;">
                                                                </div>

                                                                <!-- Image -->
                                                                <div
                                                                    class="flex-shrink-0 w-16 h-12 rounded-lg bg-black/30 flex items-center justify-center overflow-hidden relative">
                                                                    <% if (ci.imageUrl) { %>
                                                                        <img src="<%= ci.imageUrl %>" alt=""
                                                                            class="w-14 h-10 object-contain transform group-hover:scale-110 transition-transform duration-300"
                                                                            loading="lazy"
                                                                            onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<span class=\'text-lg\'>🔫</span>'">
                                                                        <% } else { %>
                                                                            <span class="text-xl">🔫</span>
                                                                            <% } %>
                                                                </div>

                                                                <!-- Info -->
                                                                <div class="flex-1 min-w-0 z-10">
                                                                    <p class="text-xs font-bold text-gray-200 truncate group-hover:text-white transition-colors"
                                                                        title="<%= ci.market_hash_name %>">
                                                                        <%= ci.market_hash_name %>
                                                                    </p>
                                                                    <div class="flex items-center gap-2 mt-1">
                                                                        <span class="badge text-[9px] opacity-80"
                                                                            style="background:<%= ci.rarity ? ci.rarity.bg : '#333' %>;color:<%= ci.rarity ? ci.rarity.color : '#ccc' %>">
                                                                            <% if (ci.rarity) { %>
                                                                                <%= ci.rarity.name.length> 10 ?
                                                                                    ci.rarity.name.substring(0,8) + '..'
                                                                                    :
                                                                                    ci.rarity.name %>
                                                                                    <% } else { %>
                                                                                        common
                                                                                        <% } %>
                                                                        </span>
                                                                        <% if (ci.wear) { %>
                                                                            <span
                                                                                class="text-[9px] font-mono opacity-70"
                                                                                style="color:<%= ci.wear.color %>">
                                                                                <%= ci.wear.short %>
                                                                            </span>
                                                                            <% } %>
                                                                    </div>
                                                                </div>

                                                                <!-- Price Tag -->
                                                                <div
                                                                    class="text-right flex-shrink-0 z-10 flex flex-col items-end gap-1">
                                                                    <div
                                                                        class="px-2 py-1 rounded-md bg-black/40 border border-white/5 group-hover:border-cs-orange/30 transition-colors">
                                                                        <p
                                                                            class="text-xs font-bold font-mono <%= ci.price ? 'text-white' : 'text-gray-600' %>">
                                                                            <%= ci.price ? '€' + ci.price.toFixed(2)
                                                                                : '—' %>
                                                                        </p>
                                                                    </div>
                                                                    <% if (ci.stickers && ci.stickers.length> 0) { %>
                                                                        <div class="flex -space-x-1">
                                                                            <% ci.stickers.forEach(function(sticker) {
                                                                                %>
                                                                                <% if (sticker.image_url) { %>
                                                                                    <img src="<%= sticker.image_url %>"
                                                                                        class="w-4 h-4 object-contain rounded-full bg-black/50 border border-black/20"
                                                                                        title="<%= sticker.name %>">
                                                                                    <% } %>
                                                                                        <% }) %>
                                                                        </div>
                                                                        <% } %>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } %>

                                        <!-- ============ TAB: Main Inventory ============ -->
                                        <% if (tab==='main' ) { %>
                                            <div class="fade-in">
                                                <div class="glass rounded-2xl p-5 mb-4">
                                                    <div class="flex items-center justify-between">
                                                        <div>
                                                            <p class="text-sm font-semibold text-gray-300">
                                                                Inventaire
                                                                Principal</p>
                                                            <p class="text-xs text-gray-500">
                                                                <%= mainInventory.count %> items
                                                            </p>
                                                        </div>
                                                        <p class="text-xl font-bold text-cs-orange">€<%=
                                                                mainInventory.total.toFixed(2) %>
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                                                    <% mainInventory.items.forEach(function(mi) { %>
                                                        <div class="glass rounded-xl p-4 item-card glass-hover cursor-pointer item-click-target"
                                                            data-name="<%= mi.market_hash_name %>"
                                                            data-image="<%= mi.imageUrl %>"
                                                            data-rarity-color="<%= mi.rarity ? mi.rarity.color : '#ccc' %>"
                                                            data-rarity-name="<%= mi.rarity ? mi.rarity.name : 'Common' %>">
                                                            <div class="flex gap-3">
                                                                <div
                                                                    class="flex-shrink-0 w-[72px] h-[54px] rounded-lg bg-black/30 flex items-center justify-center overflow-hidden">
                                                                    <% if (mi.imageUrl) { %>
                                                                        <img src="<%= mi.imageUrl %>" alt=""
