# Server
PORT=3000
REFRESH_INTERVAL=10

# Session – used to encrypt Steam credentials in memory (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Node environment (development | production)
NODE_ENV=development

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# Pricing queues (Steam is conservative by default)
# Legacy compatibility (used as fallback for STEAM_PROXY_WORKERS if set)
STEAM_QUEUE_CONCURRENCY=1
STEAM_QUEUE_INTERVAL_MS=3500
STEAM_QUEUE_INTERVAL_CAP=1
# Parallel pricing fetch workers (Steam)
PRICE_FETCH_CONCURRENCY=10
PRICE_FETCH_RETRY_ATTEMPTS=3
PRICE_FETCH_RETRY_BACKOFF_MS=1200
# Limit stale_or_missing checks per cycle to keep runtime bounded
PRICE_REFRESH_MAX_ITEMS_PER_CYCLE=300
STEAM_PROXY_WORKERS=10
STEAM_DIRECT_WORKERS=1
STEAM_PROXY_POOL_SIZE=400
STEAM_PROXY_REQUEST_ATTEMPTS=4
STEAM_PROXY_FETCH_TIMEOUT_MS=8000
STEAM_PROXY_REFRESH_MS=1800000
STEAM_PROXY_ACQUIRE_TIMEOUT_MS=4000
STEAM_PROXY_ERROR_COOLDOWN_MS=5000
STEAM_PROXY_MAX_ERROR_COOLDOWN_MS=45000
STEAM_PROXY_REJECTED_COOLDOWN_MS=600000
STEAM_PROXY_VERIFY_ENABLED=true
STEAM_PROXY_VERIFY_TIMEOUT_MS=2500
STEAM_PROXY_VERIFY_CONCURRENCY=100
STEAM_PROXY_VERIFY_SAMPLE_SIZE=120
STEAM_PROXY_VERIFY_MAX_PROBES=300
# Optional custom Steam probe URL/market hash used to validate proxy health
STEAM_PROXY_VERIFY_URL=
STEAM_PROXY_VERIFY_MARKET_HASH_NAME=AK-47 | Redline (Field-Tested)
# Optional custom sources (comma-separated URLs, plain text ip:port)
STEAM_FREE_PROXY_SOURCES=

# Cron only refreshes prices when they are older than this
PRICE_STALE_HOURS=20
# Skip re-checking items that repeatedly return "no fresh price" for this duration
NO_FRESH_PRICE_CHECK_COOLDOWN_MINUTES=360

# CSFloat source
CSFLOAT_ENABLED=true
# USD -> EUR conversion used for CSFloat listing prices
CSFLOAT_USD_TO_EUR=0.92
CSFLOAT_TIMEOUT_MS=10000
# CSFloat API key (required in practice, otherwise requests can return 403)
# Accepts raw key or "Bearer <key>" format
CSFLOAT_API_KEY=
# Cooldown after CSFloat 429 before retrying
CSFLOAT_RATE_LIMIT_COOLDOWN_MS=60000
# Max cooldown cap (with automatic backoff on repeated 429)
CSFLOAT_RATE_LIMIT_MAX_COOLDOWN_MS=300000
# Cooldown after CSFloat 401/403 to avoid request spam
CSFLOAT_FORBIDDEN_COOLDOWN_MS=300000

# CSFloat queue
CSFLOAT_QUEUE_CONCURRENCY=1
CSFLOAT_QUEUE_INTERVAL_MS=1500
CSFLOAT_QUEUE_INTERVAL_CAP=1
