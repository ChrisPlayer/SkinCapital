    <!-- ISOLATED SCRIPT FOR CRITICAL TOGGLES -->
    <script>
        // Defined globally and safely before any other logic
        window.toggleFolder = function (id) {
            try {
                // console.log('Window.toggleFolder called for:', id);
                var contents = document.getElementById('contents-' + id);
                var chevron = document.getElementById('chevron-' + id);
                var folder = document.getElementById('folder-' + id);

                if (!contents) {
                    console.error('Contents not found for id contents-' + id);
                    return;
                }

                // Check visibility using offsetHeight as a reliable indicator
                var isHidden = contents.offsetHeight === 0 || contents.style.display === 'none' || contents.classList.contains('hidden');

                if (isHidden) {
                    // FORCE OPEN
                    contents.classList.remove('hidden');
                    contents.style.display = 'block';
                    contents.style.maxHeight = 'none'; // Override CSS limit
                    contents.style.overflow = 'visible';
                    contents.classList.add('open');

                    if (folder) folder.classList.add('open');
                    if (chevron) chevron.style.transform = 'rotate(0deg)';
                } else {
                    // CLOSE
                    contents.style.display = 'none';
                    contents.style.maxHeight = '0px';
                    contents.style.overflow = 'hidden';
                    contents.classList.remove('open');
                    contents.classList.add('hidden');

                    if (folder) folder.classList.remove('open');
                    if (chevron) chevron.style.transform = 'rotate(-90deg)';
                }
            } catch (e) {
                console.error('Toggle Error:', e);
                alert('Erreur: ' + e.message);
            }
        };

        function switchTab(tabId) {
            // Hide all contents
            document.querySelectorAll('.tab-content').forEach(function (el) { el.classList.add('hidden'); });
            // Show selected
            var selected = document.getElementById(tabId);
            if (selected) selected.classList.remove('hidden');

            // Reset buttons
            document.querySelectorAll('.tab-btn').forEach(function (el) {
                el.classList.remove('bg-white/10', 'text-white', 'shadow-lg', 'border-white/20');
                el.classList.add('text-gray-400', 'hover:bg-white/5');
            });
            // Highlight selected
            var btn = document.querySelector('button[onclick="switchTab(\'' + tabId + '\')"]');
            if (btn) {
                btn.classList.remove('text-gray-400', 'hover:bg-white/5');
                btn.classList.add('bg-white/10', 'text-white', 'shadow-lg', 'border-white/20');
            }
        }

        function collapseAll() {
            document.querySelectorAll('.folder-contents').forEach(function (el) {
                el.classList.add('hidden');
                el.style.display = 'none';
                el.classList.remove('open');
            });
            document.querySelectorAll('[id^="chevron-"]').forEach(function (el) {
                el.style.transform = 'rotate(-90deg)';
            });
        }
    </script>

    <!-- CHART AND SEARCH LOGIC -->
    <script>
        // Chart
        try {
            var historyData = <% - JSON.stringify(historyData) %>;
            var ctx = document.getElementById('historyChart');
            if (historyData && historyData.length > 0) {
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: historyData.map(function (d) { return new Date(d.date).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }); }),
                        datasets: [{
                            label: 'Valeur (€)',
                            data: historyData.map(function (d) { return d.value; }),
                            borderColor: '#DE9B35',
                            backgroundColor: 'rgba(222, 155, 53, 0.1)',
                            tension: 0.4,
                            fill: true,
                            pointRadius: 2,
                            pointHoverRadius: 5,
                            pointBackgroundColor: '#DE9B35',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        interaction: { intersect: false, mode: 'index' },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'rgba(10,14,20,0.95)', titleColor: '#fff', bodyColor: '#DE9B35',
                                borderColor: 'rgba(255,255,255,0.1)', borderWidth: 1, padding: 12,
                                callbacks: { label: function (ctx) { return '€' + ctx.parsed.y.toFixed(2); } }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: '#374151', font: { size: 10 } } },
                            y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#374151', font: { size: 10 }, callback: function (v) { return '€' + v; } } }
                        }
                    }
                });
            } else {
                if (ctx) ctx.parentElement.innerHTML = '<div class="flex items-center justify-center h-full text-gray-600 text-sm">Pas encore de données historiques</div>';
            }
        } catch (e) {
            console.error("Chart error:", e);
        }

        // Search
        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var q = searchInput.value.toLowerCase();
                var cards = document.querySelectorAll('#itemsGrid > div');
                for (var i = 0; i < cards.length; i++) {
                    cards[i].style.display = (cards[i].dataset.name || '').indexOf(q) >= 0 ? '' : 'none';
                }
            });
        }
    </script>
