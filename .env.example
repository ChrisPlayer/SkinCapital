# Server
PORT=3000
REFRESH_INTERVAL=10

# Session – used to encrypt Steam credentials in memory (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Node environment (development | production)
NODE_ENV=development

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# Pricing queues (Steam is conservative by default)
STEAM_QUEUE_CONCURRENCY=1
STEAM_QUEUE_INTERVAL_MS=3500
STEAM_QUEUE_INTERVAL_CAP=1

# Cron only refreshes prices when they are older than this
PRICE_STALE_HOURS=20

# CSFloat source
CSFLOAT_ENABLED=true
# USD -> EUR conversion used for CSFloat listing prices
CSFLOAT_USD_TO_EUR=0.92
CSFLOAT_TIMEOUT_MS=10000
# CSFloat API key (required in practice, otherwise requests can return 403)
# Accepts raw key or "Bearer <key>" format
CSFLOAT_API_KEY=
# Cooldown after CSFloat 429 before retrying
CSFLOAT_RATE_LIMIT_COOLDOWN_MS=60000
# Max cooldown cap (with automatic backoff on repeated 429)
CSFLOAT_RATE_LIMIT_MAX_COOLDOWN_MS=300000
# Cooldown after CSFloat 401/403 to avoid request spam
CSFLOAT_FORBIDDEN_COOLDOWN_MS=300000

# CSFloat queue
CSFLOAT_QUEUE_CONCURRENCY=1
CSFLOAT_QUEUE_INTERVAL_MS=1500
CSFLOAT_QUEUE_INTERVAL_CAP=1
