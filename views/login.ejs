<!DOCTYPE html>
<html lang="fr" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CS2 Inventory Tracker - Connexion</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cs: {
                            orange: '#DE9B35',
                            purple: '#8847FF',
                            pink: '#D32CE6',
                            gray: '#1B2838',
                            dark: '#0E1419'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0E1419 0%, #1B2838 50%, #0E1419 100%);
            min-height: 100vh;
        }

        .gradient-text {
            background: linear-gradient(135deg, #DE9B35, #8847FF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .glass-card {
            background: rgba(27, 40, 56, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        input:focus {
            outline: none;
            border-color: #DE9B35;
            box-shadow: 0 0 0 3px rgba(222, 155, 53, 0.2);
        }
    </style>
</head>

<body class="text-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="w-full max-w-md">
        <!-- Logo & Title -->
        <div class="text-center mb-8">
            <div
                class="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-cs-orange to-cs-purple rounded-2xl flex items-center justify-center shadow-2xl">
                <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M21.4 8.5l-4.9-4.9c-.4-.4-1-.4-1.4 0L12 6.7 8.9 3.6c-.4-.4-1-.4-1.4 0L2.6 8.5c-.4.4-.4 1 0 1.4l3.1 3.1-3.1 3.1c-.4.4-.4 1 0 1.4l4.9 4.9c.4.4 1 .4 1.4 0L12 19.3l3.1 3.1c.4.4 1 .4 1.4 0l4.9-4.9c.4-.4.4-1 0-1.4l-3.1-3.1 3.1-3.1c.4-.4.4-1 0-1.4z" />
                </svg>
            </div>
            <h1 class="text-3xl font-bold gradient-text mb-2">CS2 Inventory Tracker</h1>
            <p class="text-gray-400">Connectez-vous avec votre compte Steam</p>
        </div>

        <!-- Status (if already connected) -->
        <% if (status && status.isLoggedIn) { %>
            <div class="glass-card rounded-2xl p-6 mb-4">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-green-400 flex items-center gap-2">
                        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
                        Connecté à Steam
                    </span>
                    <span class="text-sm text-gray-400">
                        <%= status.steamId %>
                    </span>
                </div>
                <div class="flex gap-3">
                    <a href="/dashboard"
                        class="flex-1 py-3 bg-gradient-to-r from-cs-orange to-cs-purple text-center font-semibold rounded-lg hover:opacity-90 transition-opacity">
                        Dashboard
                    </a>
                    <form action="/logout" method="POST" class="flex-1">
                        <button type="submit"
                            class="w-full py-3 bg-red-500/20 text-red-400 font-semibold rounded-lg hover:bg-red-500/30 transition-colors">
                            Déconnexion
                        </button>
                    </form>
                </div>
            </div>
            <% } else { %>
                <!-- Login Form -->
                <form action="/login" method="POST" class="glass-card rounded-2xl p-6 mb-4">
                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="mb-4 p-3 bg-red-500/20 border border-red-500/50 rounded-lg text-red-300 text-sm">
                            <strong>Erreur:</strong>
                            <%= error %>
                        </div>
                        <% } %>

                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-300 mb-2">
                                    <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd"
                                            d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                                            clip-rule="evenodd" />
                                    </svg>
                                    Username Steam
                                </label>
                                <input type="text" name="username" required autocomplete="username"
                                    class="w-full px-4 py-3 bg-black/30 border border-white/10 rounded-lg text-white placeholder-gray-500"
                                    placeholder="Votre username Steam">
                            </div>

                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-300 mb-2">
                                    <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd"
                                            d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                                            clip-rule="evenodd" />
                                    </svg>
                                    Mot de passe
                                </label>
                                <input type="password" name="password" required autocomplete="current-password"
                                    class="w-full px-4 py-3 bg-black/30 border border-white/10 rounded-lg text-white placeholder-gray-500"
                                    placeholder="Votre mot de passe Steam">
                            </div>

                            <div class="mb-6">
                                <label class="block text-sm font-medium text-gray-300 mb-2">
                                    <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd"
                                            d="M6.625 2.655A9 9 0 0119 11a1 1 0 11-2 0 7 7 0 00-9.625-6.492 1 1 0 11-.75-1.853zM4.662 4.959A1 1 0 014.75 6.37 6.97 6.97 0 003 11a1 1 0 11-2 0 8.97 8.97 0 012.25-5.953 1 1 0 011.412-.088z"
                                            clip-rule="evenodd" />
                                        <path fill-rule="evenodd"
                                            d="M5 11a5 5 0 1110 0 1 1 0 11-2 0 3 3 0 10-6 0c0 1.677-.345 3.276-.968 4.729a1 1 0 11-1.838-.789A9.964 9.964 0 005 11z"
                                            clip-rule="evenodd" />
                                    </svg>
                                    Steam Guard Shared Secret (2FA)
                                </label>
                                <input type="password" name="sharedSecret" autocomplete="off"
                                    class="w-full px-4 py-3 bg-black/30 border border-white/10 rounded-lg text-white placeholder-gray-500"
                                    placeholder="Optionnel - pour auto 2FA">
                                <p class="text-xs text-gray-500 mt-1">Laissez vide si vous préférez entrer le code
                                    manuellement</p>
                            </div>

                            <button type="submit" id="loginBtn"
                                class="w-full py-3 bg-gradient-to-r from-cs-orange to-cs-purple font-semibold rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                        d="M3 3a1 1 0 011 1v12a1 1 0 11-2 0V4a1 1 0 011-1zm7.707 3.293a1 1 0 010 1.414L9.414 9H17a1 1 0 110 2H9.414l1.293 1.293a1 1 0 01-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0z"
                                        clip-rule="evenodd" />
                                </svg>
                                Se connecter
                            </button>
                </form>

                <!-- Steam Guard Code Form (if needed) -->
                <% if (typeof needsSteamGuard !=='undefined' && needsSteamGuard) { %>
                    <form action="/steamguard" method="POST" class="glass-card rounded-2xl p-6 mb-4">
                        <div class="text-center mb-4">
                            <div
                                class="w-12 h-12 mx-auto mb-3 bg-cs-orange/20 rounded-full flex items-center justify-center">
                                <svg class="w-6 h-6 text-cs-orange" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                        d="M18 8a6 6 0 01-7.743 5.743L10 14l-1 1-1 1H6v2H2v-4l4.257-4.257A6 6 0 1118 8zm-6-4a1 1 0 100 2 2 2 0 012 2 1 1 0 102 0 4 4 0 00-4-4z"
                                        clip-rule="evenodd" />
                                </svg>
                            </div>
                            <h3 class="font-semibold text-lg">Code Steam Guard requis</h3>
                            <p class="text-sm text-gray-400">Entrez le code depuis votre app Steam</p>
                        </div>
                        <input type="text" name="code" required maxlength="5" autofocus
                            class="w-full px-4 py-4 bg-black/30 border border-white/10 rounded-lg text-white text-center text-2xl tracking-widest font-mono placeholder-gray-500 uppercase"
                            placeholder="XXXXX">
                        <button type="submit"
                            class="w-full mt-4 py-3 bg-cs-orange text-white font-semibold rounded-lg hover:opacity-90">
                            Valider
                        </button>
                    </form>
                    <% } %>
                        <% } %>

                            <!-- Security Info -->
                            <div class="glass-card rounded-2xl p-4">
                                <div class="flex items-start gap-3">
                                    <svg class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" fill="currentColor"
                                        viewBox="0 0 20 20">
                                        <path fill-rule="evenodd"
                                            d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                            clip-rule="evenodd" />
                                    </svg>
                                    <div class="text-sm">
                                        <p class="text-green-400 font-medium mb-1">🔒 Connexion sécurisée</p>
                                        <ul class="text-gray-400 text-xs space-y-1">
                                            <li>• Credentials stockés en session uniquement</li>
                                            <li>• Aucun mot de passe sauvegardé sur le disque</li>
                                            <li>• Session chiffrée côté serveur</li>
                                            <li>• Lecture seule de l'inventaire</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
    </div>
</body>

</html>