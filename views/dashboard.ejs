                    </a>
                    <a id="linkCsfloat" href="#" target="_blank"
                        class="flex items-center justify-between w-full py-3 px-4 rounded-xl bg-[#4A69FF]/90 hover:bg-[#5e7aff] text-white font-medium transition-all group border border-transparent hover:border-black/20">
                        <span class="flex items-center gap-2">
                            <span class="font-black text-lg">F</span>
                            CS Float
                        </span>
                        <svg class="w-4 h-4 text-white/50 group-hover:text-white transition-colors" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Modal Logic
        async function openItemDetail(marketHashName, imageUrl, rarityColor, rarityName) {
            const modal = document.getElementById('itemModal');
            const content = document.getElementById('itemModalContent');
            const img = document.getElementById('modalImage');
            const title = document.getElementById('modalTitle');
            const rarity = document.getElementById('modalRarity');
            const price = document.getElementById('modalPrice');
            const change = document.getElementById('modalChange');

            const lSteam = document.getElementById('linkSteam');
            const lSkinport = document.getElementById('linkSkinport');
            const lCsfloat = document.getElementById('linkCsfloat');

            // Show Modal (Initial State)
            modal.classList.remove('hidden');
            // Small delay to trigger transition
            requestAnimationFrame(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            });

            // Set static data immediately
            img.src = imageUrl || '';
            title.innerText = marketHashName;

            // Handle Rarity
            const rName = rarityName && rarityName !== 'undefined' ? rarityName : 'Common';
            const rColor = rarityColor && rarityColor !== 'undefined' ? rarityColor : '#b0c3d9';
            rarity.innerText = rName;
            rarity.style.color = rColor;
            rarity.style.backgroundColor = isBright(rColor) ? 'rgba(0,0,0,0.5)' : hexToRgba(rColor, 0.15);
            rarity.style.border = `1px solid ${hexToRgba(rColor, 0.3)}`;

            price.innerText = 'Chargement...';
            price.className = 'text-lg font-bold text-gray-500 animate-pulse';
            change.innerText = '...';
            change.className = 'text-lg font-bold text-gray-600';

            // Set links immediately (client-side generation)
            const safeName = encodeURIComponent(marketHashName);
            lSteam.href = `https://steamcommunity.com/market/listings/730/${safeName}`;
            lSkinport.href = `https://skinport.com/market?search=${safeName}&cat=Counter-Strike%202`;
            lCsfloat.href = `https://csfloat.com/search?q=${safeName}`;

            try {
                // Fetch dynamic data
                const response = await fetch(`/api/item/${safeName}`);
                if (!response.ok) throw new Error('Network response was not ok');

                const data = await response.json();

                if (data.price) {
                    price.innerText = '€' + data.price.toFixed(2);
                    price.className = 'text-lg font-bold text-white';
                } else {
                    price.innerText = '—';
                    price.className = 'text-lg font-bold text-gray-500';
                }

                if (data.change && data.change.hasData) {
                    const isUp = data.change.percentage >= 0;
                    change.innerText = (isUp ? '+' : '') + '€' + data.change.change.toFixed(2) + ' (' + (isUp ? '+' : '') + data.change.percentage.toFixed(1) + '%)';
                    change.className = 'text-lg font-bold ' + (isUp ? 'text-green-400' : 'text-red-400');
                } else {
                    change.innerText = '—';
                    change.className = 'text-lg font-bold text-gray-600';
                }

                lSteam.href = data.links.steam;
                lSkinport.href = data.links.skinport;
                lCsfloat.href = data.links.csfloat;

            } catch (e) {
                console.error(e);
                price.innerText = 'Erreur';
                price.className = 'text-lg font-bold text-red-400';
            }
        }

        function closeItemModal() {
            const modal = document.getElementById('itemModal');
            const content = document.getElementById('itemModalContent');

            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // Helper: Hex to RGBA
        function hexToRgba(hex, alpha) {
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        }

        // Helper: Check brightness
        function isBright(hex) {
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            return ((r * 299) + (g * 587) + (b * 114)) / 1000 > 155;
        }

        // Close on Escape
        document.addEventListener('keydown', function (event) {
            if (event.key === "Escape") {
                closeItemModal();
            }
        });

        // Event Delegation for Item Clicks
        document.addEventListener('click', function (event) {
            const card = event.target.closest('.item-click-target');
            if (card) {
                openItemDetail(
                    card.dataset.name,
                    card.dataset.image,
                    card.dataset.rarityColor,
                    card.dataset.rarityName
                );
            }
        });
    </script>
</body>

</html>