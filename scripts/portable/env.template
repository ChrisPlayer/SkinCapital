# SkinCapital - configuration du pack portable.
# Tout le reste se regle depuis la page Parametres de l'application.
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
COOKIE_SECURE=false
# Genere automatiquement au premier lancement (unique par installation).
SESSION_SECRET=__GENERATE__
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Prix : mode auto = direct (lent mais complet) tant qu'aucun proxy n'est
# configure dans les Parametres.
STEAM_PRICING_MODE=auto
STEAM_DIRECT_INTERVAL_MS=3500
LOG_LEVEL=info
REFRESH_INTERVAL=10
