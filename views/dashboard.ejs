<!DOCTYPE html>
<html lang="fr" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CS2 Inventory Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cs: { orange: '#DE9B35', purple: '#8847FF', pink: '#D32CE6', red: '#EB4B4B', blue: '#5E98D9', gray: '#1B2838', dark: '#0E1419', surface: '#16202D' }
                    }
                }
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0a0e14;
            min-height: 100vh;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #2a3a4e;
            border-radius: 3px;
        }

        .glass {
            background: rgba(22, 32, 45, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .glass-hover:hover {
            border-color: rgba(222, 155, 53, 0.3);
            box-shadow: 0 0 30px rgba(222, 155, 53, 0.05);
        }

        .gradient-text {
            background: linear-gradient(135deg, #DE9B35, #D32CE6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .item-card {
            transition: all 0.2s ease;
        }

        .item-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        }

        .float-bar {
            height: 4px;
            border-radius: 2px;
            background: linear-gradient(90deg, #4CAF50 0%, #8BC34A 15%, #FFC107 38%, #FF9800 45%, #F44336 100%);
            position: relative;
        }

        .float-marker {
            position: absolute;
            top: -3px;
            width: 3px;
            height: 10px;
            background: white;
            border-radius: 1px;
            transform: translateX(-50%);
            box-shadow: 0 0 6px rgba(255, 255, 255, 0.5);
        }

        .tab-active {
            border-color: #DE9B35;
            color: #DE9B35;
            background: rgba(222, 155, 53, 0.1);
        }

        .tab-inactive {
            border-color: transparent;
            color: #6b7280;
        }

        .tab-inactive:hover {
            color: #9ca3af;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .folder-card {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .folder-card:hover {
            border-color: rgba(136, 71, 255, 0.4);
            box-shadow: 0 4px 20px rgba(136, 71, 255, 0.1);
        }

        .folder-card.open {
            border-color: rgba(136, 71, 255, 0.5);
        }

        .folder-contents {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease;
        }

        .folder-contents.open {
            max-height: 2000px;
            overflow-y: auto;
        }

        .fade-in {
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .item-img {
            width: 72px;
            height: 54px;
            object-fit: contain;
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
        }

        .badge {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }
    </style>
</head>

<body class="text-gray-100">
    <!-- Header -->
    <header class="sticky top-0 z-50 glass border-b border-white/5">
        <div class="max-w-[1600px] mx-auto px-6 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div
                        class="w-10 h-10 bg-gradient-to-br from-cs-orange to-cs-purple rounded-xl flex items-center justify-center shadow-lg shadow-cs-orange/20">
                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M21.4 8.5l-4.9-4.9c-.4-.4-1-.4-1.4 0L12 6.7 8.9 3.6c-.4-.4-1-.4-1.4 0L2.6 8.5c-.4.4-.4 1 0 1.4l3.1 3.1-3.1 3.1c-.4.4-.4 1 0 1.4l4.9 4.9c.4.4 1 .4 1.4 0L12 19.3l3.1 3.1c.4.4 1 .4 1.4 0l4.9-4.9c.4-.4.4-1 0-1.4l-3.1-3.1 3.1-3.1c.4-.4.4-1 0-1.4z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold gradient-text tracking-tight">CS2 Inventory Tracker</h1>
                        <p class="text-[11px] text-gray-500 flex items-center gap-2">
                            <% if (status.isConnectedToGC) { %>
                                <span class="flex items-center gap-1"><span
                                        class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span> GC
                                    Online</span>
                                <% } else { %>
                                    <span class="flex items-center gap-1 text-yellow-400"><span
                                            class="w-1.5 h-1.5 bg-yellow-400 rounded-full"></span> GC Offline</span>
                                    <% } %>
                                        <% if (lastRefresh) { %>
                                            <span class="text-gray-600">•</span>
                                            <span>MAJ: <%= new Date(lastRefresh).toLocaleTimeString('fr-FR', {
                                                    hour: '2-digit' , minute: '2-digit' }) %></span>
                                            <% } %>
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right hidden sm:block">
                        <p class="text-2xl font-extrabold text-white tracking-tight">€<%= totalValue.toFixed(2) %>
                        </p>
                        <p class="text-[11px] text-gray-500">
                            <%= totalItems %> items • Steam Market
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <form action="/dashboard/refresh" method="POST">
                            <button type="submit" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 transition-colors"
                                title="Actualiser" <%=isRefreshing ? 'disabled' : '' %>>
                                <svg class="w-4 h-4 <%= isRefreshing ? 'animate-spin text-cs-orange' : 'text-gray-400' %>"
                                    fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                            </button>
                        </form>
                        <a href="/dashboard/export"
                            class="p-2 rounded-lg bg-white/5 hover:bg-white/10 transition-colors" title="Export CSV">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </a>
                        <form action="/logout" method="POST">
                            <button type="submit"
                                class="p-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 transition-colors"
                                title="Déconnexion">
                                <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-[1600px] mx-auto px-6 py-6">
        <% if (typeof error !=='undefined' && error) { %>
            <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-300 text-sm">
                <strong>Erreur:</strong>
                <%= error %>
            </div>
            <% } %>

                <!-- KPI Cards -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6 fade-in">
                    <div class="glass rounded-2xl p-5 glass-hover">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Items Total</p>
                        <p class="text-3xl font-extrabold text-white">
                            <%= totalItems %>
                        </p>
                        <p class="text-xs text-gray-500 mt-1">
                            <%= uniqueItems %> uniques
                        </p>
                    </div>
                    <div class="glass rounded-2xl p-5 glass-hover">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Storage Units</p>
                        <p class="text-3xl font-extrabold text-cs-purple">
                            <%= storageUnits.length %>
                        </p>
                        <p class="text-xs text-gray-500 mt-1">
                            <%= totalItems - mainInventory.count %> items stockés
                        </p>
                    </div>
                    <div class="glass rounded-2xl p-5 glass-hover">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Valeur Totale</p>
                        <p class="text-3xl font-extrabold text-cs-orange">€<%= totalValue.toFixed(2) %>
                        </p>
                        <p class="text-xs text-gray-500 mt-1">Steam Market</p>
                    </div>
                    <div class="glass rounded-2xl p-5 glass-hover">
                        <p class="text-xs text-gray-500 uppercase tracking-wider mb-2">Évolution 24h</p>
                        <% if (change24h.hasData) { %>
                            <p
                                class="text-3xl font-extrabold <%= change24h.percentage >= 0 ? 'text-green-400' : 'text-red-400' %>">
                                <%= change24h.percentage>= 0 ? '+' : '' %><%= change24h.percentage.toFixed(1) %>%
                            </p>
                            <p class="text-xs text-gray-500 mt-1">
                                <%= change24h.change>= 0 ? '+' : '' %>€<%= change24h.change.toFixed(2) %>
                            </p>
                            <% } else { %>
                                <p class="text-3xl font-extrabold text-gray-600">—</p>
                                <p class="text-xs text-gray-600 mt-1">Pas de données</p>
                                <% } %>
                    </div>
                </div>

                <!-- Chart -->
                <div class="glass rounded-2xl p-6 mb-6 fade-in">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-sm font-semibold text-gray-300 uppercase tracking-wider">Historique de valeur
                        </h2>
                        <div class="flex gap-1">
                            <a href="?days=7&tab=<%= tab %>"
                                class="px-3 py-1 text-xs rounded-lg transition-all <%= days === 7 ? 'bg-cs-orange/20 text-cs-orange' : 'text-gray-500 hover:text-gray-300' %>">7J</a>
                            <a href="?days=30&tab=<%= tab %>"
                                class="px-3 py-1 text-xs rounded-lg transition-all <%= days === 30 ? 'bg-cs-orange/20 text-cs-orange' : 'text-gray-500 hover:text-gray-300' %>">30J</a>
                            <a href="?days=90&tab=<%= tab %>"
                                class="px-3 py-1 text-xs rounded-lg transition-all <%= days === 90 ? 'bg-cs-orange/20 text-cs-orange' : 'text-gray-500 hover:text-gray-300' %>">90J</a>
                        </div>
                    </div>
                    <div class="h-52"><canvas id="historyChart"></canvas></div>
                </div>

                <!-- Tabs -->
                <div class="flex gap-1 mb-6 border-b border-white/5 fade-in">
                    <a href="?tab=caskets&days=<%= days %>"
                        class="px-5 py-3 text-sm font-medium border-b-2 transition-all rounded-t-lg <%= tab === 'caskets' ? 'tab-active' : 'tab-inactive' %>">
                        🗄️ Storage Units (<%= storageUnits.length %>)
                    </a>
                    <a href="?tab=main&days=<%= days %>"
                        class="px-5 py-3 text-sm font-medium border-b-2 transition-all rounded-t-lg <%= tab === 'main' ? 'tab-active' : 'tab-inactive' %>">
                        🎒 Inventaire (<%= mainInventory.count %>)
                    </a>
                    <a href="?tab=overview&days=<%= days %>"
                        class="px-5 py-3 text-sm font-medium border-b-2 transition-all rounded-t-lg <%= tab === 'overview' ? 'tab-active' : 'tab-inactive' %>">
                        📦 Tous les Items
                    </a>
                </div>

                <!-- ============ TAB: Storage Units (Folders) ============ -->
                <% if (tab==='caskets' ) { %>
                    <div class="fade-in space-y-3">
                        <% if (storageUnits.length===0) { %>
                            <div class="glass rounded-2xl p-8 text-center text-gray-500">Aucune Storage Unit avec des
                                items</div>
                            <% } %>
                                <% storageUnits.forEach(function(su, idx) { %>
                                    <div class="glass rounded-2xl folder-card border border-white/5"
                                        id="folder-<%= su.casket_id %>">
                                        <!-- Folder Header (clickable) -->
                                        <div class="p-5 flex items-center justify-between"
                                            onclick="toggleFolder('<%= su.casket_id %>')">
                                            <div class="flex items-center gap-4">
                                                <div
                                                    class="w-12 h-12 rounded-xl bg-gradient-to-br from-cs-purple/30 to-cs-pink/20 flex items-center justify-center text-xl border border-cs-purple/20">
                                                    <span id="folder-icon-<%= su.casket_id %>">📁</span>
                                                </div>
                                                <div>
                                                    <p class="text-base font-bold text-white">Storage Unit #<%= idx + 1
                                                            %>
                                                    </p>
                                                    <p class="text-xs text-gray-500 mt-0.5">
                                                        <span class="font-mono text-gray-600">...<%= su.short_id %>
                                                                </span>
                                                        <span class="mx-2 text-gray-700">•</span>
                                                        <span>
                                                            <%= su.item_count %> items
                                                        </span>
                                                        <span class="mx-2 text-gray-700">•</span>
                                                        <span>
                                                            <%= su.unique_items %> uniques
                                                        </span>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-4">
                                                <div class="text-right">
                                                    <p class="text-xl font-extrabold text-cs-orange">€<%=
                                                            su.total_value.toFixed(2) %>
                                                    </p>
                                                </div>
                                                <svg id="chevron-<%= su.casket_id %>"
                                                    class="w-5 h-5 text-gray-500 transition-transform duration-300"
                                                    fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M19 9l-7 7-7-7" />
                                                </svg>
                                            </div>
                                        </div>
                                        <!-- Folder Contents (hidden by default) -->
                                        <div class="folder-contents" id="contents-<%= su.casket_id %>">
                                            <div class="border-t border-white/5 px-5 pb-5">
                                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2 pt-4">
                                                    <% su.items.forEach(function(ci) { %>
                                                        <div
                                                            class="flex items-center gap-3 p-3 rounded-xl bg-black/20 hover:bg-black/30 transition-colors item-card">
                                                            <!-- Image -->
                                                            <div
                                                                class="flex-shrink-0 w-14 h-11 rounded-lg bg-black/30 flex items-center justify-center overflow-hidden">
                                                                <% if (ci.imageUrl) { %>
                                                                    <img src="<%= ci.imageUrl %>" alt=""
                                                                        class="w-12 h-9 object-contain" loading="lazy"
                                                                        onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<span class=\'text-lg\'>🔫</span>'">
                                                                    <% } else { %>
                                                                        <span class="text-lg">🔫</span>
                                                                        <% } %>
                                                            </div>
                                                            <!-- Info -->
                                                            <div class="flex-1 min-w-0">
                                                                <p class="text-xs font-semibold text-gray-200 truncate"
                                                                    title="<%= ci.market_hash_name %>">
                                                                    <%= ci.market_hash_name %>
                                                                </p>
                                                                <div class="flex items-center gap-1.5 mt-0.5">
                                                                    <span class="badge"
                                                                        style="background:<%= ci.rarity.bg %>;color:<%= ci.rarity.color %>">
                                                                        <%= ci.rarity.name.length> 6 ?
                                                                            ci.rarity.name.substring(0,3) :
                                                                            ci.rarity.name %>
                                                                    </span>
                                                                    <% if (ci.wear) { %>
                                                                        <span class="text-[10px] font-mono"
                                                                            style="color:<%= ci.wear.color %>">
                                                                            <%= ci.wear.short %>
                                                                        </span>
                                                                        <% } %>
                                                                            <% if (ci.quantity> 1) { %>
                                                                                <span
                                                                                    class="text-[10px] text-gray-400 font-medium">x
                                                                                    <%= ci.quantity %></span>
                                                                                <% } %>
                                                                </div>
                                                            </div>
                                                            <!-- Price -->
                                                            <div class="text-right flex-shrink-0">
                                                                <p
                                                                    class="text-xs font-bold <%= ci.price ? 'text-white' : 'text-gray-600' %>">
                                                                    <%= ci.price ? '€' + ci.price.toFixed(2) : '—' %>
                                                                </p>
                                                                <% if (ci.quantity> 1 && ci.total > 0) { %>
                                                                    <p class="text-[10px] text-cs-orange font-semibold">
                                                                        €<%= ci.total.toFixed(2) %>
                                                                    </p>
                                                                    <% } %>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                    </div>
                    <% } %>

                        <!-- ============ TAB: Main Inventory ============ -->
                        <% if (tab==='main' ) { %>
                            <div class="fade-in">
                                <div class="glass rounded-2xl p-5 mb-4">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-sm font-semibold text-gray-300">Inventaire Principal</p>
                                            <p class="text-xs text-gray-500">
                                                <%= mainInventory.count %> items
                                            </p>
                                        </div>
                                        <p class="text-xl font-bold text-cs-orange">€<%= mainInventory.total.toFixed(2)
                                                %>
                                        </p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                                    <% mainInventory.items.forEach(function(mi) { %>
                                        <div class="glass rounded-xl p-4 item-card glass-hover">
                                            <div class="flex gap-3">
                                                <div
                                                    class="flex-shrink-0 w-[72px] h-[54px] rounded-lg bg-black/30 flex items-center justify-center overflow-hidden">
                                                    <% if (mi.imageUrl) { %>
                                                        <img src="<%= mi.imageUrl %>" alt="" class="item-img"
                                                            loading="lazy"
                                                            onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<span class=\'text-xl\'>🔫</span>'">
                                                        <% } else { %>
                                                            <span class="text-xl">🔫</span>
                                                            <% } %>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-start justify-between gap-2">
                                                        <div class="min-w-0">
                                                            <p class="text-xs font-semibold text-white truncate">
                                                                <%= mi.market_hash_name %>
                                                            </p>
                                                            <div class="flex items-center gap-1.5 mt-0.5 flex-wrap">
                                                                <span class="badge"
                                                                    style="background:<%= mi.rarity.bg %>;color:<%= mi.rarity.color %>">
                                                                    <%= mi.rarity.name %>
                                                                </span>
                                                                <% if (mi.wear) { %>
                                                                    <span class="text-[10px] font-mono"
                                                                        style="color:<%= mi.wear.color %>">
                                                                        <%= mi.wear.short %>
                                                                    </span>
                                                                    <% } %>
                                                                        <% if (mi.quantity> 1) { %>
                                                                            <span
                                                                                class="badge bg-white/10 text-gray-300">x
                                                                                <%= mi.quantity %></span>
                                                                            <% } %>
                                                            </div>
                                                        </div>
                                                        <div class="text-right flex-shrink-0">
                                                            <p class="text-sm font-bold text-cs-orange">€<%= mi.price ?
                                                                    mi.price.toFixed(2) : '—' %>
                                                            </p>
                                                            <% if (mi.quantity> 1 && mi.total > 0) { %>
                                                                <p class="text-[10px] text-gray-500">Total: €<%=
                                                                        mi.total.toFixed(2) %>
                                                                </p>
                                                                <% } %>
                                                        </div>
                                                    </div>
                                                    <% if (mi.float_value) { %>
                                                        <div class="mt-1.5">
                                                            <div class="float-bar">
                                                                <div class="float-marker"
                                                                    style="left:<%= (mi.float_value * 100) %>%"></div>
                                                            </div>
                                                        </div>
                                                        <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                            </div>
                            <% } %>

                                <!-- ============ TAB: Overview ============ -->
                                <% if (tab==='overview' ) { %>
                                    <div class="fade-in">
                                        <div class="mb-4">
                                            <div class="relative max-w-sm">
                                                <input type="text" id="searchInput" placeholder="Rechercher un item..."
                                                    class="w-full px-4 py-2.5 pl-10 bg-cs-surface border border-white/5 rounded-xl text-sm focus:outline-none focus:border-cs-orange/50 transition-colors">
                                                <svg class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2"
                                                    fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                                </svg>
                                            </div>
                                        </div>

                                        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3"
                                            id="itemsGrid">
                                            <% items.forEach(function(item) { %>
                                                <div class="glass rounded-xl p-4 item-card glass-hover"
                                                    data-name="<%= item.market_hash_name.toLowerCase() %>">
                                                    <div class="flex gap-3">
                                                        <div
                                                            class="flex-shrink-0 w-[72px] h-[54px] rounded-lg bg-black/30 flex items-center justify-center overflow-hidden">
                                                            <% if (item.imageUrl) { %>
                                                                <img src="<%= item.imageUrl %>" alt="" class="item-img"
                                                                    loading="lazy"
                                                                    onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<span class=\'text-2xl\'>🔫</span>'">
                                                                <% } else { %>
                                                                    <span class="text-2xl">🔫</span>
                                                                    <% } %>
                                                        </div>
                                                        <div class="flex-1 min-w-0">
                                                            <div class="flex items-start justify-between gap-2">
                                                                <div class="min-w-0">
                                                                    <p class="text-sm font-semibold text-white truncate"
                                                                        title="<%= item.market_hash_name %>">
                                                                        <%= item.market_hash_name %>
                                                                    </p>
                                                                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                                                                        <span class="badge"
                                                                            style="background:<%= item.rarity.bg %>;color:<%= item.rarity.color %>">
                                                                            <%= item.rarity.name %>
                                                                        </span>
                                                                        <% if (item.quantity> 1) { %>
                                                                            <span
                                                                                class="badge bg-white/10 text-gray-300">x
                                                                                <%= item.quantity %></span>
                                                                            <% } %>
                                                                                <% if (item.casket_ids.length> 0) { %>
                                                                                    <span
                                                                                        class="badge bg-cs-purple/15 text-cs-purple">📦
                                                                                        <%= item.casket_ids.length %>
                                                                                            </span>
                                                                                    <% } %>
                                                                    </div>
                                                                </div>
                                                                <div class="text-right flex-shrink-0">
                                                                    <p class="text-sm font-bold text-cs-orange">€<%=
                                                                            item.prices.steam ?
                                                                            item.prices.steam.toFixed(2) : '—' %>
                                                                    </p>
                                                                    <% if (item.quantity> 1 && item.total > 0) { %>
                                                                        <p class="text-[10px] text-gray-500">Total: €<%=
                                                                                item.total.toFixed(2) %>
                                                                        </p>
                                                                        <% } %>
                                                                </div>
                                                            </div>
                                                            <% if (item.float_value) { %>
                                                                <div class="mt-2">
                                                                    <div
                                                                        class="flex items-center justify-between text-[10px] text-gray-500 mb-0.5">
                                                                        <span
                                                                            style="color:<%= item.wear ? item.wear.color : '#999' %>">
                                                                            <%= item.wear ? item.wear.name : '' %>
                                                                        </span>
                                                                        <span class="font-mono">
                                                                            <%= item.float_value.toFixed(8) %>
                                                                        </span>
                                                                    </div>
                                                                    <div class="float-bar">
                                                                        <div class="float-marker"
                                                                            style="left:<%= (item.float_value * 100) %>%">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>

                                        <% if (pagination.totalPages> 1) { %>
                                            <div class="flex items-center justify-center gap-2 mt-6">
                                                <% if (pagination.page> 1) { %><a
                                                        href="?page=<%= pagination.page - 1 %>&days=<%= days %>&tab=overview"
                                                        class="px-3 py-1.5 text-sm bg-white/5 rounded-lg hover:bg-white/10">←</a>
                                                    <% } %>
                                                        <% for (var p=Math.max(1, pagination.page - 2); p
                                                            <=Math.min(pagination.totalPages, pagination.page + 2); p++)
                                                            { %>
                                                            <a href="?page=<%= p %>&days=<%= days %>&tab=overview"
                                                                class="px-3 py-1.5 text-sm rounded-lg <%= p === pagination.page ? 'bg-cs-orange text-white' : 'bg-white/5 hover:bg-white/10' %>">
                                                                <%= p %>
                                                            </a>
                                                            <% } %>
                                                                <% if (pagination.page < pagination.totalPages) { %><a
                                                                        href="?page=<%= pagination.page + 1 %>&days=<%= days %>&tab=overview"
                                                                        class="px-3 py-1.5 text-sm bg-white/5 rounded-lg hover:bg-white/10">→</a>
                                                                    <% } %>
                                            </div>
                                            <% } %>
                                    </div>
                                    <% } %>

                                        <!-- Price Alerts -->
                                        <% if (priceAlerts.length> 0) { %>
                                            <div class="glass rounded-2xl p-5 mt-6 fade-in">
                                                <h3
                                                    class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">
                                                    ⚡ Alertes de prix</h3>
                                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2">
                                                    <% priceAlerts.slice(0, 6).forEach(function(alert) { %>
                                                        <div
                                                            class="flex items-center justify-between px-3 py-2 rounded-lg bg-black/20 border-l-2 <%= alert.direction === 'up' ? 'border-green-500' : 'border-red-500' %>">
                                                            <span class="text-xs truncate flex-1 mr-2">
                                                                <%= alert.market_hash_name %>
                                                            </span>
                                                            <span
                                                                class="text-xs font-bold <%= alert.direction === 'up' ? 'text-green-400' : 'text-red-400' %>">
                                                                <%= alert.percentage> 0 ? '+' : '' %><%=
                                                                        alert.percentage.toFixed(1) %>%
                                                            </span>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                            </div>
                                            <% } %>
    </main>

    <script>
        // Chart
        var historyData = <% - JSON.stringify(historyData) %>;
        var ctx = document.getElementById('historyChart');
        if (historyData.length > 0) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: historyData.map(function (d) { return new Date(d.date).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }); }),
                    datasets: [{
                        label: 'Valeur (€)',
                        data: historyData.map(function (d) { return d.value; }),
                        borderColor: '#DE9B35',
                        backgroundColor: 'rgba(222, 155, 53, 0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 2,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#DE9B35',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(10,14,20,0.95)', titleColor: '#fff', bodyColor: '#DE9B35',
                            borderColor: 'rgba(255,255,255,0.1)', borderWidth: 1, padding: 12,
                            callbacks: { label: function (ctx) { return '€' + ctx.parsed.y.toFixed(2); } }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#374151', font: { size: 10 } } },
                        y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#374151', font: { size: 10 }, callback: function (v) { return '€' + v; } } }
                    }
                }
            });
        } else {
            ctx.parentElement.innerHTML = '<div class="flex items-center justify-center h-full text-gray-600 text-sm">Pas encore de données historiques</div>';
        }

        // Search
        var searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                var q = searchInput.value.toLowerCase();
                var cards = document.querySelectorAll('#itemsGrid > div');
                for (var i = 0; i < cards.length; i++) {
                    cards[i].style.display = (cards[i].dataset.name || '').indexOf(q) >= 0 ? '' : 'none';
                }
            });
        }

        // Folder toggle
        function toggleFolder(id) {
            var contents = document.getElementById('contents-' + id);
            var chevron = document.getElementById('chevron-' + id);
            var icon = document.getElementById('folder-icon-' + id);
            var folder = document.getElementById('folder-' + id);
            if (contents) {
                var isOpen = contents.classList.contains('open');
                contents.classList.toggle('open');
                if (chevron) chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
                if (icon) icon.textContent = isOpen ? '📁' : '📂';
                if (folder) folder.classList.toggle('open', !isOpen);
            }
        }

        // Auto-refresh poll
        <% if (isRefreshing) { %>
            setInterval(function () {
                fetch('/dashboard/api/status').then(function (r) { return r.json(); }).then(function (d) { if (!d.isRefreshing) location.reload(); });
            }, 5000);
        <% } %>
    </script>
</body>

</html>