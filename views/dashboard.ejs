<!DOCTYPE html>
<html lang="fr" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CS2 Inventory Tracker - Dashboard">
    <title>CS2 Inventory Tracker - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cs: {
                            orange: '#DE9B35',
                            purple: '#8847FF',
                            pink: '#D32CE6',
                            red: '#EB4B4B',
                            blue: '#5E98D9',
                            gray: '#1B2838',
                            dark: '#0E1419'
                        }
                    }
                }
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0E1419 0%, #1B2838 50%, #0E1419 100%);
            min-height: 100vh;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #1B2838;
        }

        ::-webkit-scrollbar-thumb {
            background: #3D4F5F;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #5E98D9;
        }

        .glass-card {
            background: rgba(27, 40, 56, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .gradient-text {
            background: linear-gradient(135deg, #DE9B35, #D32CE6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .pulse-animation {
            animation: pulse 2s infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        .table-row-hover:hover {
            background: rgba(94, 152, 217, 0.1);
        }

        .fade-in {
            animation: fadeIn 0.3s ease-in;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body class="text-gray-100">
    <!-- Header -->
    <header class="sticky top-0 z-50 glass-card border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div
                        class="w-10 h-10 bg-gradient-to-br from-cs-orange to-cs-purple rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M21.4 8.5l-4.9-4.9c-.4-.4-1-.4-1.4 0L12 6.7 8.9 3.6c-.4-.4-1-.4-1.4 0L2.6 8.5c-.4.4-.4 1 0 1.4l3.1 3.1-3.1 3.1c-.4.4-.4 1 0 1.4l4.9 4.9c.4.4 1 .4 1.4 0L12 19.3l3.1 3.1c.4.4 1 .4 1.4 0l4.9-4.9c.4-.4.4-1 0-1.4l-3.1-3.1 3.1-3.1c.4-.4.4-1 0-1.4z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold gradient-text">CS2 Inventory Tracker</h1>
                        <p class="text-xs text-gray-400">
                            <% if (status.isConnectedToGC) { %>
                                <span class="inline-flex items-center gap-1"><span
                                        class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span> GC
                                    Connecté</span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1 text-yellow-400"><span
                                            class="w-1.5 h-1.5 bg-yellow-400 rounded-full"></span> GC Déconnecté</span>
                                    <% } %>
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-6">
                    <div class="text-right">
                        <p class="text-3xl font-bold text-white">€<%= totalValue.toLocaleString('fr-FR', {
                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </p>
                        <p class="text-xs text-gray-400">Valeur totale</p>
                    </div>
                    <% if (lastRefresh) { %>
                        <div class="text-xs text-gray-400 text-right">
                            <p>Dernière màj</p>
                            <p class="text-gray-300">
                                <%= new Date(lastRefresh).toLocaleString('fr-FR') %>
                            </p>
                        </div>
                        <% } %>
                            <form action="/logout" method="POST">
                                <button type="submit"
                                    class="px-3 py-2 bg-red-500/20 text-red-400 rounded-lg hover:bg-red-500/30 transition-colors text-sm font-medium">
                                    Déconnexion
                                </button>
                            </form>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-6">
        <% if (typeof error !=='undefined' && error) { %>
            <div class="mb-6 p-4 bg-red-500/20 border border-red-500/50 rounded-lg text-red-300">
                <strong>Erreur:</strong>
                <%= error %>
            </div>
            <% } %>

                <!-- KPI Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <!-- Total Items -->
                    <div class="glass-card rounded-xl p-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-400 mb-1">Nombre d'items</p>
                                <p class="text-3xl font-bold text-white">
                                    <%= totalItems.toLocaleString() %>
                                </p>
                                <p class="text-xs text-gray-500 mt-1">
                                    <%= uniqueItems %> items uniques
                                </p>
                            </div>
                            <div class="w-12 h-12 bg-cs-blue/20 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-cs-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Total Value -->
                    <div class="glass-card rounded-xl p-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-400 mb-1">Valeur moyenne</p>
                                <p class="text-3xl font-bold text-white">€<%= totalValue.toLocaleString('fr-FR', {
                                        minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </p>
                                <p class="text-xs text-gray-500 mt-1">Moyenne Steam + APIs</p>
                            </div>
                            <div class="w-12 h-12 bg-cs-orange/20 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-cs-orange" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- 24h Evolution -->
                    <div class="glass-card rounded-xl p-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm text-gray-400 mb-1">Évolution 24h</p>
                                <% if (change24h.hasData) { %>
                                    <p
                                        class="text-3xl font-bold <%= change24h.percentage >= 0 ? 'text-green-400' : 'text-red-400' %>">
                                        <%= change24h.percentage>= 0 ? '+' : '' %><%= change24h.percentage.toFixed(2) %>
                                                %
                                    </p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        <%= change24h.change>= 0 ? '+' : '' %>€<%= change24h.change.toFixed(2) %>
                                    </p>
                                    <% } else { %>
                                        <p class="text-3xl font-bold text-gray-500">--</p>
                                        <p class="text-xs text-gray-500 mt-1">Pas assez de données</p>
                                        <% } %>
                            </div>
                            <div
                                class="w-12 h-12 <%= change24h.percentage >= 0 ? 'bg-green-500/20' : 'bg-red-500/20' %> rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 <%= change24h.percentage >= 0 ? 'text-green-400' : 'text-red-400' %>"
                                    fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="<%= change24h.percentage >= 0 ? 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' : 'M13 17h8m0 0V9m0 8l-8-8-4 4-6-6' %>" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chart Section -->
                <div class="glass-card rounded-xl p-6 mb-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-semibold">Historique de valeur</h2>
                        <div class="flex gap-2">
                            <a href="?days=7"
                                class="px-3 py-1 text-sm rounded-lg transition-colors <%= days === 7 ? 'bg-cs-purple text-white' : 'bg-white/5 text-gray-400 hover:bg-white/10' %>">7
                                jours</a>
                            <a href="?days=30"
                                class="px-3 py-1 text-sm rounded-lg transition-colors <%= days === 30 ? 'bg-cs-purple text-white' : 'bg-white/5 text-gray-400 hover:bg-white/10' %>">30
                                jours</a>
                        </div>
                    </div>
                    <div class="h-64">
                        <canvas id="historyChart"></canvas>
                    </div>
                </div>

                <!-- Price Alerts -->
                <% if (priceAlerts.length> 0) { %>
                    <div class="glass-card rounded-xl p-6 mb-6">
                        <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">
                            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                    d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                                    clip-rule="evenodd" />
                            </svg>
                            Alertes de prix (±5%)
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                            <% priceAlerts.slice(0, 6).forEach(alert=> { %>
                                <div
                                    class="flex items-center justify-between p-3 rounded-lg bg-black/20 border-l-4 <%= alert.direction === 'up' ? 'border-green-500' : 'border-red-500' %>">
                                    <span class="text-sm truncate flex-1 mr-2" title="<%= alert.market_hash_name %>">
                                        <%= alert.market_hash_name %>
                                    </span>
                                    <span
                                        class="text-sm font-semibold <%= alert.direction === 'up' ? 'text-green-400' : 'text-red-400' %> whitespace-nowrap">
                                        <%= alert.percentage> 0 ? '+' : '' %><%= alert.percentage.toFixed(1) %>%
                                    </span>
                                </div>
                                <% }) %>
                        </div>
                    </div>
                    <% } %>

                        <!-- Items Table -->
                        <div class="glass-card rounded-xl p-6 mb-6">
                            <div
                                class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-4">
                                <h2 class="text-lg font-semibold">Inventaire (<%= totalItems %> items)</h2>
                                <div class="flex flex-wrap gap-3">
                                    <!-- Search -->
                                    <div class="relative">
                                        <input type="text" id="searchInput" placeholder="Rechercher..."
                                            class="w-48 px-4 py-2 pl-10 bg-black/30 border border-white/10 rounded-lg text-sm focus:outline-none focus:border-cs-purple">
                                        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"
                                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                        </svg>
                                    </div>
                                    <!-- Casket Filter -->
                                    <select id="casketFilter"
                                        class="px-4 py-2 bg-black/30 border border-white/10 rounded-lg text-sm focus:outline-none focus:border-cs-purple">
                                        <option value="">Tous les Storage Units</option>
                                        <% casketIds.forEach(id=> { %>
                                            <option value="<%= id %>">Casket <%= id.substring(0, 8) %>...</option>
                                            <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div class="overflow-x-auto">
                                <table class="w-full text-sm" id="itemsTable">
                                    <thead>
                                        <tr class="text-left text-gray-400 border-b border-white/10">
                                            <th class="py-3 px-2 cursor-pointer hover:text-white"
                                                onclick="sortTable(0)">Item ↕</th>
                                            <th class="py-3 px-2 text-center cursor-pointer hover:text-white"
                                                onclick="sortTable(1)">Qté ↕</th>
                                            <th class="py-3 px-2 cursor-pointer hover:text-white"
                                                onclick="sortTable(2)">Float ↕</th>
                                            <th class="py-3 px-2">Storage Unit</th>
                                            <th class="py-3 px-2 text-right cursor-pointer hover:text-white"
                                                onclick="sortTable(4)">Steam ↕</th>
                                            <th class="py-3 px-2 text-right cursor-pointer hover:text-white"
                                                onclick="sortTable(5)">Skinport ↕</th>
                                            <th class="py-3 px-2 text-right cursor-pointer hover:text-white"
                                                onclick="sortTable(6)">Moyenne ↕</th>
                                            <th class="py-3 px-2 text-right font-semibold cursor-pointer hover:text-white"
                                                onclick="sortTable(7)">Total ↕</th>
                                        </tr>
                                    </thead>
                                    <tbody id="itemsBody">
                                        <% items.forEach((item, index)=> { %>
                                            <tr class="border-b border-white/5 table-row-hover transition-colors"
                                                data-name="<%= item.market_hash_name.toLowerCase() %>"
                                                data-casket="<%= item.casket_ids.join(',') %>">
                                                <td class="py-3 px-2">
                                                    <span class="truncate block max-w-[200px]"
                                                        title="<%= item.market_hash_name %>">
                                                        <%= item.market_hash_name %>
                                                    </span>
                                                </td>
                                                <td class="py-3 px-2 text-center">
                                                    <span
                                                        class="bg-cs-blue/20 text-cs-blue px-2 py-0.5 rounded text-xs font-medium">
                                                        <%= item.quantity %>
                                                    </span>
                                                </td>
                                                <td class="py-3 px-2 text-gray-400 font-mono text-xs">
                                                    <%= item.float_value ? item.float_value.toFixed(6) : '-' %>
                                                </td>
                                                <td class="py-3 px-2 text-gray-400 text-xs">
                                                    <% if (item.casket_ids.length> 0) { %>
                                                        <span
                                                            class="bg-cs-purple/20 text-cs-purple px-2 py-0.5 rounded">
                                                            <%= item.casket_ids.length %> casket(s)
                                                        </span>
                                                        <% } else { %>
                                                            <span class="text-gray-500">Main</span>
                                                            <% } %>
                                                </td>
                                                <td class="py-3 px-2 text-right text-gray-300">
                                                    <%= item.prices.steam ? '€' + item.prices.steam.toFixed(2) : '-' %>
                                                </td>
                                                <td class="py-3 px-2 text-right text-gray-300">
                                                    <%= item.prices.skinport ? '€' + item.prices.skinport.toFixed(2)
                                                        : '-' %>
                                                </td>
                                                <td class="py-3 px-2 text-right text-white font-medium">
                                                    <%= item.prices.average ? '€' + item.prices.average.toFixed(2) : '-'
                                                        %>
                                                </td>
                                                <td class="py-3 px-2 text-right text-cs-orange font-semibold">
                                                    €<%= item.total.toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <% if (pagination.totalPages> 1) { %>
                                <div class="flex items-center justify-between mt-4 pt-4 border-t border-white/10">
                                    <p class="text-sm text-gray-400">
                                        Affichage <%= ((pagination.page - 1) * pagination.perPage) + 1 %> - <%=
                                                Math.min(pagination.page * pagination.perPage, pagination.total) %> sur
                                                <%= pagination.total %>
                                    </p>
                                    <div class="flex gap-2">
                                        <% if (pagination.page> 1) { %>
                                            <a href="?page=<%= pagination.page - 1 %>&days=<%= days %>"
                                                class="px-3 py-1 bg-white/5 rounded-lg hover:bg-white/10 transition-colors">Précédent</a>
                                            <% } %>
                                                <% for (let p=Math.max(1, pagination.page - 2); p
                                                    <=Math.min(pagination.totalPages, pagination.page + 2); p++) { %>
                                                    <a href="?page=<%= p %>&days=<%= days %>"
                                                        class="px-3 py-1 rounded-lg transition-colors <%= p === pagination.page ? 'bg-cs-purple text-white' : 'bg-white/5 hover:bg-white/10' %>">
                                                        <%= p %>
                                                    </a>
                                                    <% } %>
                                                        <% if (pagination.page < pagination.totalPages) { %>
                                                            <a href="?page=<%= pagination.page + 1 %>&days=<%= days %>"
                                                                class="px-3 py-1 bg-white/5 rounded-lg hover:bg-white/10 transition-colors">Suivant</a>
                                                            <% } %>
                                    </div>
                                </div>
                                <% } %>
                        </div>

                        <!-- Actions Footer -->
                        <div class="glass-card rounded-xl p-4 flex flex-wrap items-center justify-between gap-4">
                            <div class="flex items-center gap-4">
                                <form action="/refresh" method="POST" class="inline">
                                    <button type="submit"
                                        class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-cs-orange to-cs-purple rounded-lg font-medium hover:opacity-90 transition-opacity <%= isRefreshing ? 'opacity-50 cursor-not-allowed' : '' %>"
                                        <%=isRefreshing ? 'disabled' : '' %>>
                                        <svg class="w-4 h-4 <%= isRefreshing ? 'animate-spin' : '' %>" fill="none"
                                            stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                        </svg>
                                        <%= isRefreshing ? 'Actualisation...' : 'Actualiser' %>
                                    </button>
                                </form>
                                <a href="/export"
                                    class="flex items-center gap-2 px-4 py-2 bg-white/10 rounded-lg font-medium hover:bg-white/20 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                    Exporter CSV
                                </a>
                            </div>
                            <div class="text-sm text-gray-400">
                                <% if (isRefreshing) { %>
                                    <span class="flex items-center gap-2">
                                        <span class="w-2 h-2 bg-cs-orange rounded-full animate-pulse"></span>
                                        Actualisation en cours...
                                    </span>
                                    <% } else { %>
                                        Auto-refresh toutes les 10 min
                                        <% } %>
                            </div>
                        </div>
    </main>

    <script>
        // Chart.js initialization
        const historyData = <% - JSON.stringify(historyData) %>;
        const ctx = document.getElementById('historyChart');

        if (historyData.length > 0) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: historyData.map(d => new Date(d.date).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' })),
                    datasets: [{
                        label: 'Valeur totale (€)',
                        data: historyData.map(d => d.value),
                        borderColor: '#DE9B35',
                        backgroundColor: 'rgba(222, 155, 53, 0.1)',
                        tension: 0.3,
                        fill: true,
                        pointRadius: 3,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(27, 40, 56, 0.9)',
                            titleColor: '#fff',
                            bodyColor: '#DE9B35',
                            borderColor: 'rgba(255, 255, 255, 0.1)',
                            borderWidth: 1,
                            callbacks: {
                                label: ctx => '€' + ctx.parsed.y.toLocaleString('fr-FR', { minimumFractionDigits: 2 })
                            }
                        }
                    },
                    scales: {
                        x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#6b7280' } },
                        y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#6b7280', callback: v => '€' + v.toLocaleString() } }
                    }
                }
            });
        } else {
            ctx.parentElement.innerHTML = '<div class="flex items-center justify-center h-full text-gray-500">Pas encore de données historiques</div>';
        }

        // Search functionality
        document.getElementById('searchInput').addEventListener('input', filterTable);
        document.getElementById('casketFilter').addEventListener('change', filterTable);

        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const casket = document.getElementById('casketFilter').value;
            const rows = document.querySelectorAll('#itemsBody tr');

            rows.forEach(row => {
                const name = row.dataset.name;
                const caskets = row.dataset.casket;
                const matchesSearch = !search || name.includes(search);
                const matchesCasket = !casket || caskets.includes(casket);
                row.style.display = matchesSearch && matchesCasket ? '' : 'none';
            });
        }

        // Sort functionality
        let sortDir = {};
        function sortTable(col) {
            const table = document.getElementById('itemsTable');
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));

            sortDir[col] = !sortDir[col];

            rows.sort((a, b) => {
                let aVal = a.cells[col].innerText.replace(/[€,]/g, '').trim();
                let bVal = b.cells[col].innerText.replace(/[€,]/g, '').trim();

                // Try numeric sort
                const aNum = parseFloat(aVal) || 0;
                const bNum = parseFloat(bVal) || 0;

                if (!isNaN(aNum) && !isNaN(bNum)) {
                    return sortDir[col] ? aNum - bNum : bNum - aNum;
                }

                // String sort
                return sortDir[col] ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
            });

            rows.forEach(row => tbody.appendChild(row));
        }

        // Auto-refresh status check
        <% if (isRefreshing) { %>
            setInterval(() => {
                fetch('/api/status')
                    .then(r => r.json())
                    .then(data => {
                        if (!data.isRefreshing) {
                            window.location.reload();
                        }
                    });
            }, 3000);
        <% } %>
    </script>
</body>

</html>