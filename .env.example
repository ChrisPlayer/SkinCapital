# Server
PORT=3000
# Bind address. Keep 127.0.0.1 unless you need LAN access — only change it behind HTTPS
# (your Steam password would otherwise transit in cleartext at login).
HOST=127.0.0.1
REFRESH_INTERVAL=10

# Where state lives (SQLite DB, item schema cache, generated session secret).
# Relocated by the platform shells: next to the exe on Windows, /data in Docker.
#DATA_DIR=./data
# Open the browser once the server listens (used by the Windows pack).
#OPEN_BROWSER=0

# Session – signs the session cookie AND encrypts the stored proxies at rest (AES-256-GCM).
# Steam credentials are NEVER stored, so this does not protect them.
# Optional in production: when unset, a secret is generated once and persisted
# in DATA_DIR/.session-secret. Set one explicitly to override it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Node environment (development | production)
NODE_ENV=development

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# Pricing queues (Steam is conservative by default)
# Legacy compatibility (used as fallback for STEAM_PROXY_WORKERS if set)
STEAM_QUEUE_CONCURRENCY=1
STEAM_QUEUE_INTERVAL_MS=3500
# Parallel pricing fetch workers (Steam)
PRICE_FETCH_CONCURRENCY=10
PRICE_FETCH_RETRY_ATTEMPTS=3
PRICE_FETCH_RETRY_BACKOFF_MS=1200
# Limit stale_or_missing checks per cycle to keep runtime bounded
PRICE_REFRESH_MAX_ITEMS_PER_CYCLE=300
STEAM_PROXY_WORKERS=10
STEAM_DIRECT_WORKERS=1
STEAM_PROXY_POOL_SIZE=400
STEAM_PROXY_REQUEST_ATTEMPTS=4
STEAM_PROXY_FETCH_TIMEOUT_MS=8000
STEAM_PROXY_REFRESH_MS=1800000
STEAM_PROXY_ACQUIRE_TIMEOUT_MS=4000
STEAM_PROXY_ERROR_COOLDOWN_MS=5000
STEAM_PROXY_MAX_ERROR_COOLDOWN_MS=45000
STEAM_PROXY_REJECTED_COOLDOWN_MS=600000
STEAM_PROXY_VERIFY_ENABLED=true
STEAM_PROXY_VERIFY_TIMEOUT_MS=2500
STEAM_PROXY_VERIFY_CONCURRENCY=100
STEAM_PROXY_VERIFY_SAMPLE_SIZE=120
STEAM_PROXY_VERIFY_MAX_PROBES=300
# Optional custom Steam probe URL/market hash used to validate proxy health
STEAM_PROXY_VERIFY_URL=
STEAM_PROXY_VERIFY_MARKET_HASH_NAME=AK-47 | Redline (Field-Tested)
# Optional custom sources (comma-separated URLs, plain text ip:port)
STEAM_FREE_PROXY_SOURCES=

# Cron only refreshes prices when they are older than this
PRICE_STALE_HOURS=20
# How long a fetched price stays "fresh" in the cache before being re-fetched (hours)
PRICE_CACHE_TTL_HOURS=20
# Cooldown after a Steam Market 429 before retrying (ms)
STEAM_RATE_LIMIT_COOLDOWN_MS=60000
# Skip re-checking items that returned no price at all for this duration (min 5 minutes)
MISSING_PRICE_CHECK_COOLDOWN_MINUTES=60
# Skip re-checking items that repeatedly return "no fresh price" for this duration
NO_FRESH_PRICE_CHECK_COOLDOWN_MINUTES=360

# CSFloat source
CSFLOAT_ENABLED=true
# USD -> EUR conversion used for CSFloat listing prices
CSFLOAT_USD_TO_EUR=0.92
CSFLOAT_TIMEOUT_MS=10000
# CSFloat API key (required in practice, otherwise requests can return 403)
# Accepts raw key or "Bearer <key>" format
CSFLOAT_API_KEY=
# Cooldown after CSFloat 429 before retrying
CSFLOAT_RATE_LIMIT_COOLDOWN_MS=60000
# Max cooldown cap (with automatic backoff on repeated 429)
CSFLOAT_RATE_LIMIT_MAX_COOLDOWN_MS=300000
# Cooldown after CSFloat 401/403 to avoid request spam
CSFLOAT_FORBIDDEN_COOLDOWN_MS=300000

# CSFloat queue
CSFLOAT_QUEUE_CONCURRENCY=1
CSFLOAT_QUEUE_INTERVAL_MS=1500
CSFLOAT_QUEUE_INTERVAL_CAP=1

# Skinport source (bulk price list, no API key needed)
# Cache TTL for the bulk price list (ms)
SKINPORT_TTL_MS=600000

# --- Pricing mode (proxies optional) ---
# auto (default): proxy if STEAM_PROXIES is set, otherwise direct.
#   proxy  = fast, uses your paid proxies (near-instant on big inventories).
#   direct = no proxy, ONE request at a time over your own IP, throttled so Steam
#            is never rate-limited. Slower (a large inventory may take a while)
#            but every single item gets priced.
STEAM_PRICING_MODE=auto
# Spacing between Steam requests in DIRECT mode (ms). Higher = safer / slower.
STEAM_DIRECT_INTERVAL_MS=3500
# Optional paid proxies, comma-separated: host:port:user:pass or http://user:pass@host:port
# Can also be set from the Settings page in the UI (stored encrypted in the DB).
STEAM_PROXIES=

# Comma-separated browser origins allowed for CORS + CSRF (add your LAN host/IP here).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
